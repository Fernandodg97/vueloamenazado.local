<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ "Recuperar contraseña"|gettext }}</title>
    <!-- Vincular CSS de Bootstrap desde la carpeta bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
    <<!-- Selección de idioma -->
        <div class="d-flex justify-content-between">
            <a href="?lang=es" class="btn btn-primary">{{ "Español"|gettext }}</a>
            <a href="?lang=en" class="btn btn-primary">{{ "Inglés"|gettext }}</a>
        </div>
        <div class="row justify-content-center">
        

            <div class="col-md-6">
                <!-- Mostrar mensaje de error -->
                {% if error %}
                    <div class="alert alert-danger" role="alert">
                        {{ error }}
                    </div>
                {% endif %}

                <!-- Mostrar mensaje de éxito -->
                {% if success %}
                    <div class="alert alert-success" role="alert">
                        {{ success }}
                    </div>
                {% endif %}

                <div class="card">
                    <div class="card-header text-center">
                        <h4>{{ "Recuperar contraseña"|gettext }}</h4>
                    </div>
                    <div class="card-body">
                        <!-- Formulario de recuperación de contraseña -->
                        <form action="" method="post">
                            <div class="form-group">
                                <label for="email">{{ "Correo electrónico"|gettext }}</label>
                                <input type="email" id="email" name="email" class="form-control" required>
                            </div>
                            <div class="form-group mt-4">
                                <button type="submit" class="btn btn-primary btn-block">{{ "Enviar enlace de recuperación"|gettext }}</button>
                            </div>
                        </form>
                        <div class="mt-3 text-center">
                            <p class="text-muted">{{ "Función en desarrollo, disculpen las molestias. Para recuperar la contraseña pónganse en contacto con"|gettext }} 
                                <a href="mailto:fdiaz@elpuig.xeill.net">fdiaz@elpuig.xeill.net</a>.</p>
                        </div>
                        <div class="form-group mt-3 text-center">
                            <a href="login">{{ "Volver al inicio de sesión"|gettext }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vincular JS de Bootstrap desde la carpeta bootstrap -->
        <!-- BOTÓN PARA SUBIR AL INICIO -->
    <button id="btnScrollToTop" class="btn btn-primary position-fixed bottom-0 end-0 m-4 d-none" title="Subir al inicio" style="z-index: 1050; border-radius: 50%; width: 50px; height: 50px; font-size: 20px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">▲</button>
    <script>
      const btnScrollToTop = document.getElementById("btnScrollToTop");
      window.addEventListener("scroll", function () {
        if (window.scrollY > 300) { btnScrollToTop.classList.remove("d-none"); }
        else { btnScrollToTop.classList.add("d-none"); }
      });
      btnScrollToTop.addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
