<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ "Vuelo Amenazado"|gettext }}</title>
    <!-- Vincular CSS de Bootstrap desde la carpeta bootstrap -->    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .error-container {
            text-align: center;
            padding: 50px;
        }

        .error-container h1 {
            font-size: 6rem;
        }

        .error-container p {
            font-size: 1.5rem;
        }

        /* Estilos responsivos */
        @media (max-width: 768px) {
            .error-container h1 {
                font-size: 4rem;
            }

            .error-container p {
                font-size: 1.2rem;
            }

            .btn {
                width: 100%;
                margin-top: 20px;
            }
        }

        @media (max-width: 480px) {
            .error-container h1 {
                font-size: 3rem;
            }

            .error-container p {
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <div class="container mt-5">
       <!-- Selección de idioma -->
        <div class="d-flex justify-content-between">
            <a href="?lang=es" class="btn btn-primary">{{ "Español"|gettext }}</a>
            <a href="?lang=en" class="btn btn-primary">{{ "Inglés"|gettext }}</a>
        </div>

        <div class="error-container mt-4">
            <h1 class="display-1">404</h1>
            <p class="lead">{{ "Has llegado al final de Internet."|gettext }}</p>
            <a href="/" class="btn btn-primary">{{ "Ir al inicio"|gettext }}</a>
        </div>
    </div>

    <!-- Vincular JS de Bootstrap desde la carpeta bootstrap -->
        <!-- BOTÓN PARA SUBIR AL INICIO -->
    <button id="btnScrollToTop" class="btn btn-primary position-fixed bottom-0 end-0 m-4 d-none" title="Subir al inicio" style="z-index: 1050; border-radius: 50%; width: 50px; height: 50px; font-size: 20px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">▲</button>
    <script>
      const btnScrollToTop = document.getElementById("btnScrollToTop");
      window.addEventListener("scroll", function () {
        if (window.scrollY > 300) { btnScrollToTop.classList.remove("d-none"); }
        else { btnScrollToTop.classList.add("d-none"); }
      });
      btnScrollToTop.addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
